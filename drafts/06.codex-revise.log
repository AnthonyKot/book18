-<tr><td>Onboarding</td><td>1 × €20k = 20</td><td>5 × €20k = 100</td></tr>
-<tr><td>Recurring control/evidence</td><td>3 sites × 6 months × €4.5k = 81</td><td>15 sites × 12 months × €4.5k = 810</td></tr>
-<tr><td><strong>Revenue</strong></td><td><strong>119</strong></td><td><strong>974</strong></td></tr>
+<tr><td>Paid baselines: no installer discount</td><td>3 × €6k = 18</td><td>8 × €8k = 64</td></tr>
+<tr><td>Onboarding: €20k retail less 25% installer discount</td><td>1 × €20k × 75% = 15</td><td>5 × €20k × 75% = 75</td></tr>
+<tr><td>Recurring: €4.5k retail less 25% installer discount</td><td>3 sites × 6 months × €4.5k × 75% = 60.75</td><td>15 sites × 12 months × €4.5k × 75% = 607.5</td></tr>
+<tr><td><strong>Net wholesale receipts</strong></td><td><strong>93.75</strong></td><td><strong>746.5</strong></td></tr>
 <tr><td>Pass-through hardware and installation</td><td>0</td><td>0</td></tr>
