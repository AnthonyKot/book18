from pathlib import Path
from html.parser import HTMLParser
import re
class P(HTMLParser):
 def __init__(self): super().__init__(); self.parts=[]; self.stack=[]; self.units=[]
 def handle_starttag(self,t,a): self.stack.append(t)
 def handle_endtag(self,t):
  if t in ('p','li','td'):
   txt=' '.join(self.parts).strip(); self.units.append((t,txt)); self.parts=[]
  if self.stack: self.stack.pop()
 def handle_data(self,d):
  if any(x in self.stack for x in ('main',)) and not any(x in self.stack for x in ('script','style')): self.parts.append(d)
p=P(); p.feed(Path('chapters/04-asset-intelligence.html').read_text());
# Parser simplistic units sufficient; strip until main footer manually for whole count
raw=Path('chapters/04-asset-intelligence.html').read_text()
raw=raw[raw.index('<main'):raw.index('</main>')]
text=re.sub('<["'^>]+>'"',' ',raw)
text=re.sub(r'<"'!--.*?-->'"',' ',text)
words=re.findall(r\"\\b[\\w€%–—'’/-]+\\b\",text)
print('main words',len(words))
for tag,t in p.units:
 for sent in re.split(r'(?<=[."'!?])'"\\s+(?=[A-Z“\\\"€])', t):
  n=len(re.findall(r\"\\b[\\w€%–—'’/-]+\\b\",sent))
  if n>40: print(n,tag,sent)
